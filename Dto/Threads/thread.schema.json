{
    "$schema": "http://json-schema.org/draft/2019-09/schema",
    "description": "Модель треда",
    "type": "object",
    "required": [
        "rootMessage",
        "threadMessages"
    ],
    "properties": {
        "rootMessage": {
            "$ref": "../Messages/message.schema.json",
            "description": "Корневое сообщение треда",
            "nullable": false
        },
        "threadMessages": {
            "$ref": "../Messages/messages.schema.json",
            "description": "Сообщения треда",
            "nullable": false
        }
    }
}