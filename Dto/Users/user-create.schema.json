{
    "$schema": "http://json-schema.org/draft/2019-09/schema",
    "description": "Модель создания пользователя",
    "type": "object",
    "required": [
        "email",
        "approveCode"
    ],
    "properties": {
        "email": {
            "type": "string",
            "format": "email",
            "description": "Email пользователя",
            "nullable": false,
            "unique": true
        },
        "approveCode": {
            "type": "string",
            "description": "Код подтверждения",
            "nullable": false,
            "example": "123456"
        }
    }
}