{
    "$schema": "http://json-schema.org/draft/2019-09/schema",
    "description": "Модель токенов",
    "type": "object",
    "required": [
        "accessToken",
        "refreshToken"
    ],
    "properties": {
        "accessToken": {
            "type": "string",
            "description": "Access токен",
            "nullable": false,
            "example": "Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..Tpt51aicwd9mhgMr456i9GZ_4tCF3K0TfwgsrKGMKoM"
        },
        "refreshToken": {
            "type": "string",
            "description": "Refresh токен",
            "nullable": false,
            "example": "876ebb63-01c0-4d9b-a1a8-34580361f29f"
        }
    }
}