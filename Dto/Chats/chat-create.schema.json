{
    "$schema": "http://json-schema.org/draft/2019-09/schema",
    "description": "Модель создания чата",
    "type": "object",
    "required": [
        "chatName",
        "usersIds"
    ],
    "properties": {
        "chatName": {
            "type": "string",
            "description": "Название чата",
            "nullable": false
        },
        "usersIds": {
            "type": "array",
            "description": "Список идентификаторов пользователей",
            "items": {
                "type": "string",
                "format": "uuid"
            },
            "minItems": 1,
            "uniqueItems": true,
            "nullable": false
        }
    }
}
